namespace BankService.Infrastructure.Persistence.Models;

/// <summary>
/// Infrastructure-oriented persistence model for a bank account. This is a flat
/// POCO that mirrors how the account is stored (value objects flattened to
/// primitives). It is intentionally a separate type from the domain
/// <see cref="BankService.Domain.Entities.BankAccount"/> so the persistence shape
/// can evolve independently of the domain model.
/// </summary>
public sealed class BankAccountRecord
{
    public Guid Id { get; set; }
    public Guid CustomerId { get; set; }
    public string AccountNumber { get; set; } = string.Empty;
    public int EarningScore { get; set; }
    public string Status { get; set; } = string.Empty;
    public List<DocumentRecord> Documents { get; set; } = [];
    public DateTime CreatedOnUtc { get; set; }
}

/// <summary>
/// Persistence model for a document attached to an account. Stored as part of the
/// owning <see cref="BankAccountRecord"/> because a document has no life outside its
/// aggregate.
/// </summary>
public sealed class DocumentRecord
{
    public Guid Id { get; set; }
    public string Uri { get; set; } = string.Empty;
    public string FileName { get; set; } = string.Empty;
    public string VerificationStatus { get; set; } = string.Empty;
    public DateTime UploadedOnUtc { get; set; }
}
